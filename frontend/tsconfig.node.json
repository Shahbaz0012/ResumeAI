{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2020",

    "lib": ["ES2020"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "types": ["node"],

    "skipLibCheck": true,

    "noEmit": true,

    "strict": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "noFallthroughCasesInSwitch": true
  },

  "include": ["vite.config.ts"]
}